{
  "rules": {
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "!data.exists()",
        "player1": {
          ".write": "!data.exists() || (data.exists() && !newData.child('symbol').exists())"
        },
        "player2": {
          ".write": "!data.child('joined').val() || newData.child('joined').val() === true"
        },
        "board": {
          ".write": "root.child('games').child($gameId).child('status').val() === 'playing'"
        },
        "currentTurn": {
          ".write": "root.child('games').child($gameId).child('status').val() === 'playing'"
        },
        "status": {
          ".write": "(data.val() === 'waiting' && newData.val() === 'playing') || newData.val() === 'finished' || (data.val() === 'finished' && newData.val() === 'playing')"
        },
        "winner": {
          ".write": "root.child('games').child($gameId).child('status').val() === 'finished' || newData.parent().child('status').val() === 'finished'"
        },
        "startingPlayer": {
          ".write": true
        },
        ".indexOn": [
          "status"
        ]
      }
    }
  }
}